                },
                "accordion_row_BRJtWw": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Who discovered Alguronic Acid?",
                    "name": "",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_88HXky": {
                      "type": "text",
                      "settings": {
                        "text": "<p>After years of research into microalgae as a renewable energy source, our biotechnology scientists unexpectedly discovered a powerful protective and regenerative compound with incredible anti-aging properties known as Alguronic Acid.</p>",
                        "width": "100%",
                        "max_width": "normal",
