                    "padding-inline-end": 0
                  },
                  "blocks": {}
                },
                "text_dNbYrY": {
                  "type": "text",
                  "settings": {
                    "text": "<p>From that discovery came Alguronic Acid® —our patented ingredient that makes skin look firmer, smoother, and better in just 10 days.</p>",
                    "width": "100%",
                    "max_width": "narrow",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
                    "background": false,
