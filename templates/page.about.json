                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                },
                "text_i8qmeC": {
                  "type": "text",
                  "settings": {
                    "text": "<p><strong>Who discovered Alguronic Acid?</strong></p><p>After years of research into microalgae as a renewable energy source, our biotechnology scientists unexpectedly discovered a powerful protective and regenerative compound with incredible anti-aging properties known as Alguronic Acid.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
