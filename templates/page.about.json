                  "type": "text",
                  "name": "t:names.heading",
                  "settings": {
                    "text": "<h2>While the industry was busy recycling the same buzzwords, we discovered a microscopic powerhouse hiding in plain sight.</h2>",
                    "width": "fit-content",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "h2",
