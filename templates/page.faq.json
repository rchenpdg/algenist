                  ]
                },
                "accordion_row_eHRPfW": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "How do I create an Algenist.com account?",
                    "name": "shipping-and-returns",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_6kQ3MN": {
                      "type": "text",
                      "settings": {
                        "text": "<p>To create an Algenist.com account, please visit and complete the account page at: <a href=\"https://account.algenist.com/\" target=\"_blank\" title=\"https://account.algenist.com/\">account.algenist.com</a>. Once registered, you will receive an email confirming the creation of your Algenist.com account. Please be sure to check your spam folder in case the email is accidentally filtered as spam. You will be able to log-in to your Algenist.com account at: <a href=\"https://account.algenist.com/\" target=\"_blank\" title=\"https://account.algenist.com/\">account.algenist.com</a>.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
