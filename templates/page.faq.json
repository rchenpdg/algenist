                },
                "accordion_row_f3JbPX": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Does anyone else see the information that I provide to Algenist.com?",
                    "name": "shipping-and-returns",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_eXW9hj": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Algenist respects your privacy and does not sell, rent, or license any of our customers' personal information. The information you provide will not be given to any third party. For more information, please see our <a href=\"/policies/privacy-policy\" title=\"/policies/privacy-policy\">Privacy Policy</a>.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
