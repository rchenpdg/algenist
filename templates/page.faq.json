                },
                "accordion_row_c9nR9Y": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "What is your return policy?",
                    "name": "shipping-and-returns",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_ypwB9F": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Your satisfaction is important to us. If you are not completely happy with your Algenist skincare products, you may return them within 30 days of your order date. If you received a free gift with your purchase, you must return the free gift in addition to the products purchased. You will receive a full refund on the cost of your purchase. </p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
