                  "block_order": [
                    "text_Wain74"
                  ]
                },
                "accordion_row_bznKtL": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Does Algenist test on animals?",
                    "name": "",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_TRwHJj": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Algenist does not test on animals or ask others to do so on our behalf, except where required by law or regulation. We are committed to ethical practices throughout the entire product development process—from research and manufacturing to every step of the value chain—and carefully vet our ingredient suppliers to ensure they share our commitment to non-animal testing. Product safety and efficacy are evaluated using clinical, non-animal methods with volunteer human panels.<br/></p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
