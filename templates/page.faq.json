                  "blocks": {
                    "text_JTAT8Q": {
                      "type": "text",
                      "settings": {
                        "text": "<p><a href=\"https://www.algenist.com/collections/skincare\">Algenist skincare products</a> provide highly effective results and benefits for all skin types.<br/><br/></p>",
                        "width": "100%",
