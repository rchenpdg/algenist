                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_UeMLhV"
                  ]
                },
                "accordion_row_KWg3jA": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "What is Diversion and what are the risks of purchasing diverted products.",
                    "name": "",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_mq6afL": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Products sold by unauthorized retailers or sites are referred to as ‘diverted’ because they are products diverted from authorized sellers. Authentic Algenist products are sold only through approved retailers. Diverted products can be counterfeit, old or expired, diluted or filled with unknown substances. In short, they may not be safe to use. If you buy Algenist products from unauthorized resellers, we cannot guarantee that they will perform as advertised and tested. Contaminated or counterfeit products could also cause adverse reactions such as irritation or infection.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
