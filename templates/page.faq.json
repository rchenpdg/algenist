                  ]
                },
                "accordion_row_8fBjJA": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Is it safe to use my credit card?",
                    "name": "shipping-and-returns",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_cz3dhA": {
                      "type": "text",
                      "settings": {
                        "text": "<p>To ensure that your order is placed safely and securely on Algenist.com, we've implemented Secure Socket Layer (SSL) encryption technology. This is the most advanced consumer online security technique to date. For further information regarding the the SSL certificate please go to https://algenist.com/ and click on the lock icon that appears on your address bar.</p>",
                        "width": "100%",
                        "max_width": "normal",
