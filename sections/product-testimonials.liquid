{% if section.blocks.size > 0 and section.blocks.first.settings.heading != blank %}
    <div class="
        section
        section--page-width
        color-{{ section.settings.color_scheme }}
        spacing-style
        gap-style
    "
    style="
        {% render 'spacing-style', settings: section.settings %}
        {% render 'gap-style', value: section.settings.gap %}
    ">
        <div class="section-product-testimonials__content">
            <div class="product-testimonials__header text-center">
                {% if section.settings.heading != blank %}
                    <h2 class="product-testimonials__heading">{{ section.settings.heading }}</h2>
                {% endif %}
            </div>

            <div class="product-testimonials__testimonials">
                {% assign slide_count = 0 %}
                {% capture slides %}
                    {% for block in section.blocks %}
                        {% assign slide_count = slide_count | plus: 1 %}
                        {% capture slide %}
                        {% # theme-check-disable UniqueStaticBlockId %}
                            <div class="testimonial-slide">
                                <div class="text-block text-center">
                                    {{ block.settings.heading }}
                                </div>
                            
                            </div>
                        {% # theme-check-enable UniqueStaticBlockId %}
                        {% endcapture %}

                        {% render 'slideshow-slide', children: slide, index: forloop.index0 %}
                    {% endfor %}
                {% endcapture %}

                {% render 'slideshow',
                    slides: slides,
                    slide_count: slide_count,
                    class: 'product-testimonials__slideshow desktop:hidden',
                    ref: 'slideshow',
                    show_arrows: true,
                    icon_style: "chevron",
                    arrows_position: "center",
                %}

                <div class="product-testimonials__grid mobile:hidden">
                    {% for block in section.blocks %}
                        <div class="testimonial-slide">
                            <div class="text-block text-center">
                                {{ block.settings.heading }}
                            </div>
                        
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endif %}

{% stylesheet %}
.product-testimonials__header {
    margin-bottom: 2rem;
}

@media screen and (min-width: 750px) {
    .product-testimonials__header {
        margin-bottom: 3.75rem;
    }
}

.testimonial-slide .text-block {
    gap: 1.75rem;
}

.product-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4.75rem;
}
{% endstylesheet %}

{% schema %}
{
    "name": "Product Testimonials",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "What Our Customers Are Saying"
        },
                {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:content.padding"
        },
        {
            "type": "range",
            "id": "padding-block-start",
            "label": "t:settings.top",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding-block-end",
            "label": "t:settings.bottom",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 0
        }
    ],
    "blocks": [
        {
            "name": "Testimonial",
            "type": "testimonial",
            "settings": [
                {
                    "type": "text",
                    "id": "star_rating",
                    "label": "Star Rating",
                    "default": "5.0 Stars"
                },
                {
                    "type": "richtext",
                    "id": "heading",
                    "label": "Heading",
                    "default": "<p>Amazing product! Highly recommend.</p>" 
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Product Testimonials",
            "category": "Products"
        }
    ]
}
{% endschema %}