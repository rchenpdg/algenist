<div class="sticky-buy-button__section">
    {% content_for 'block',
        type: '_sticky-buy-button',
        id: 'sticky-buy-button',
        closest.product: closest.product
    %}
</div>

{% schema %}
{
    "name": "Sticky Buy Button",
    "settings": [
        {
        "type": "header",
        "content": "t:content.padding"
        },
        {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
        },
        {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
        }
    ],
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "presets": [
        {
            "name": "Sticky Buy Button"
        }
    ]
}
{% endschema %}