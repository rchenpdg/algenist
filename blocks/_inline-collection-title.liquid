{%- doc -%}
  @param {string} [suffix] - The suffix to add to the collection title
{%- enddoc -%}

{%- assign block_settings = block.settings -%}
{% if closest.collection == blank %}
  {% assign collection_title = 'placeholders.collection_title' | t %}
{% elsif closest.collection != blank %}
  {% assign collection_title = closest.collection.title %}
{% endif %}

{% assign plain_text = collection_title | strip_newlines | strip_html | strip %}

{% liquid
  assign block_settings = block.settings

  capture text_block_classes
    if block_settings.type_preset == 'custom'
      echo ' custom-typography '
      if block_settings.font_size != ''
        echo ' custom-font-size '
      endif
    endif
  endcapture
%}

{% capture attributes %}
  class="
    inline-collection-title
    {{ block_settings.type_preset }}
    {% if block_settings.weight != blank %}custom-font-weight{% endif %}
    {% if block_settings.font_size != blank %}custom-font-size{% endif %}
    {{ text_block_classes }}
  "

  style="
    {% render 'typography-style', settings: block_settings %}
  "

  {{ block.shopify_attributes }}
{% endcapture %}

{% # We need to make sure the wrapper is rendered even if the text element is empty in the theme editor to allow live text editing %}
{%- if plain_text != '' or request.design_mode -%}
  <span
    {{ attributes }}
  >
    <span>{{ collection_title }}</span>{{ suffix }}
  </span>
{%- endif -%}

