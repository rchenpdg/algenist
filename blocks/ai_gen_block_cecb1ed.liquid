{% doc %}
  @prompt
    CTA button, ability to select CTA style (button or link) and ability to change text color. ability to choose right aligned or stacked on mobile, stacked on mobile should be stacked below the heading / heading with eyebrows, change eyebrows font-weight to 400,  if CTA is link, the underscore should be right below text looking like <u></u> effect, if mobile layout is below heading, CTA should be left aligned, reduce CTA and heading gap by half, ABILITY TO CONFIGURE CTA text size. If CTA style is link, add underline on the CTA text, CTA text field can take html
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{%- liquid
  assign cta_visible_label = block.settings.cta_text | strip_html | strip
  assign cta_label_key = cta_visible_label | downcase
  assign cta_slug = block.settings.cta_link | split: '?' | first | split: '/' | last | replace: '-', ' ' | strip
  assign cta_accessible_name = cta_visible_label
  if cta_slug != blank
    if cta_label_key == 'shop now' or cta_label_key == 'shop' or cta_label_key == 'shop best sellers' or cta_label_key == 'learn more' or cta_label_key == 'read more' or cta_label_key == 'discover' or cta_label_key == 'shop all' or cta_label_key == 'view all' or cta_label_key == 'get started'
      assign cta_accessible_name = cta_visible_label | append: ', ' | append: cta_slug
    endif
  endif
-%}
{% style %}
.ai-cta-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%}.ai-cta-{{ ai_gen_id }}__inner{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;width:100%}.ai-cta-{{ ai_gen_id }}__content{flex:1 1 auto;min-width:0}.ai-cta-{{ ai_gen_id }}__eyebrow{margin:0 0 8px;color:{{ block.settings.eyebrow_color }};font-size:12px;font-weight:400;letter-spacing:.12em;line-height:1.3;text-transform:uppercase}.ai-cta-{{ ai_gen_id }}__heading{margin:0;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px;font-weight:500;line-height:1.15}.ai-cta-{{ ai_gen_id }}__actions{flex:0 0 auto}.ai-cta-{{ ai_gen_id }}__link,.ai-cta-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 24px;color:{{ block.settings.text_color }};font:inherit;font-size:{{ block.settings.cta_text_size }}px;font-weight:500;line-height:1.2;text-align:center;cursor:pointer}.ai-cta-{{ ai_gen_id }}__button{background:{{ block.settings.button_background }};border:{{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};border-radius:{{ block.settings.button_radius }}px;text-decoration:none}.ai-cta-{{ ai_gen_id }}__button:hover{background:{{ block.settings.button_hover_background }};color:{{ block.settings.button_hover_text_color }};border-color:{{ block.settings.button_hover_border_color }}}.ai-cta-{{ ai_gen_id }}__link{padding-right:0;padding-left:0;text-decoration-line:underline;text-decoration-thickness:1px;text-underline-offset:3px}.ai-cta-{{ ai_gen_id }}__link:hover{color:{{ block.settings.link_hover_color }}}.ai-cta-{{ ai_gen_id }}__link:focus-visible,.ai-cta-{{ ai_gen_id }}__button:focus-visible{outline:2px solid currentColor;outline-offset:3px}@media screen and (max-width:749px){.ai-cta-{{ ai_gen_id }}__inner{ {% if block.settings.mobile_layout == 'stacked' %}display:block{% else %}align-items:flex-end;flex-direction:row{% endif %}}{% if block.settings.mobile_layout == 'stacked' %}.ai-cta-{{ ai_gen_id }}__actions{margin-top:10px;text-align:left}.ai-cta-{{ ai_gen_id }}__button,.ai-cta-{{ ai_gen_id }}__link{width:auto;justify-content:flex-start}{% endif %}}
{% endstyle %}
<div class="ai-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-cta-{{ ai_gen_id }}__inner"><div class="ai-cta-{{ ai_gen_id }}__content">{% if block.settings.eyebrow != blank %}<p class="ai-cta-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="ai-cta-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}</div>{% if block.settings.cta_text != blank %}<div class="ai-cta-{{ ai_gen_id }}__actions">{% if block.settings.cta_style == 'button' %}<a class="ai-cta-{{ ai_gen_id }}__button" href="{{ block.settings.cta_link }}"{% if cta_accessible_name != cta_visible_label %} aria-label="{{ cta_accessible_name | escape }}"{% endif %}>{{ block.settings.cta_text }}</a>{% else %}<a class="ai-cta-{{ ai_gen_id }}__link" href="{{ block.settings.cta_link }}"{% if cta_accessible_name != cta_visible_label %} aria-label="{{ cta_accessible_name | escape }}"{% endif %}>{{ block.settings.cta_text }}</a>{% endif %}</div>{% endif %}</div></div>
{% schema %}{"name":"CTA button","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Featured collection"},{"type":"text","id":"heading","label":"Heading","default":"Explore the collection"},{"type":"html","id":"cta_text","label":"CTA text","default":"Shop now"},{"type":"url","id":"cta_link","label":"CTA link"},{"type":"select","id":"cta_style","label":"CTA style","options":[{"value":"button","label":"Button"},{"value":"link","label":"Link"}],"default":"button"},{"type":"select","id":"mobile_layout","label":"Mobile layout","options":[{"value":"right","label":"Right aligned"},{"value":"stacked","label":"Below heading"}],"default":"right"},{"type":"color","id":"eyebrow_color","label":"Eyebrow color","default":"#2D5A55"},{"type":"color","id":"heading_color","label":"Heading color","default":"#000000"},{"type":"color","id":"text_color","label":"CTA text color","default":"#000000"},{"type":"range","id":"cta_text_size","label":"CTA text size","min":10,"max":30,"step":1,"unit":"px","default":14},{"type":"range","id":"heading_size","label":"Heading size","min":16,"max":56,"step":2,"unit":"px","default":28},{"type":"color","id":"button_background","label":"Button background","default":"#40807A"},{"type":"color","id":"button_hover_background","label":"Button hover background","default":"#2D5A55"},{"type":"color","id":"button_hover_text_color","label":"Button hover text","default":"#FFFFFF"},{"type":"color","id":"button_border_color","label":"Button border","default":"#40807A"},{"type":"color","id":"button_hover_border_color","label":"Button hover border","default":"#2D5A55"},{"type":"color","id":"link_hover_color","label":"Link hover color","default":"#2D5A55"},{"type":"range","id":"button_border_width","label":"Border width","min":0,"max":4,"step":1,"unit":"px","default":0},{"type":"range","id":"button_radius","label":"Corner radius","min":0,"max":40,"step":1,"unit":"px","default":4},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"CTA button"}],"tag":null,"class":"cta-block"}{% endschema %}