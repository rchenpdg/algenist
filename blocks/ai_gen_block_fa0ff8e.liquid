{% doc %}
  @prompt
    create a block with header and eyebrows (text above header) and optional subtext (stacked below title)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-heading-content-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; color: {{ block.settings.text_color }}; text-align: {{ block.settings.alignment }}; }
  .ai-heading-content-{{ ai_gen_id }}__eyebrow { margin: 0 0 8px; color: {{ block.settings.eyebrow_color }}; font-family: var(--font-accent-family, var(--font-body-family, sans-serif)); font-size: {{ block.settings.eyebrow_size }}px; font-weight: 600; letter-spacing: .12em; line-height: 1.3; text-transform: uppercase; }
  .ai-heading-content-{{ ai_gen_id }}__title { margin: 0; color: {{ block.settings.text_color }}; font-family: var(--font-heading-family, var(--font-body-family, sans-serif)); font-size: {{ block.settings.title_size }}px; font-weight: 400; letter-spacing: -.02em; line-height: 1.1; }
  .ai-heading-content-{{ ai_gen_id }}__subtext { max-width: 720px; margin: 14px auto 0; color: {{ block.settings.subtext_color }}; font-family: var(--font-body-family, sans-serif); font-size: {{ block.settings.subtext_size }}px; line-height: 1.5; }
  .ai-heading-content-{{ ai_gen_id }}[data-alignment='left'] .ai-heading-content-{{ ai_gen_id }}__subtext { margin-left: 0; }
  .ai-heading-content-{{ ai_gen_id }}[data-alignment='right'] .ai-heading-content-{{ ai_gen_id }}__subtext { margin-right: 0; }
  @media screen and (max-width: 749px) { .ai-heading-content-{{ ai_gen_id }} { width: 100%; } .ai-heading-content-{{ ai_gen_id }}__title { font-size: {{ block.settings.title_size | times: 0.75 | round }}px; } }
{% endstyle %}

<div class="ai-heading-content-{{ ai_gen_id }}" data-alignment="{{ block.settings.alignment }}" {{ block.shopify_attributes }}>
  {% if block.settings.eyebrow != blank %}<p class="ai-heading-content-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
  {% if block.settings.title != blank %}<h2 class="ai-heading-content-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h2>{% endif %}
  {% if block.settings.subtext != blank %}<div class="ai-heading-content-{{ ai_gen_id }}__subtext">{{ block.settings.subtext | escape | newline_to_br }}</div>{% endif %}
</div>

{% schema %}
{
  "name": "Heading with eyebrow",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured collection" },
    { "type": "text", "id": "title", "label": "Header", "default": "Discover something new" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Explore thoughtfully selected products made for your everyday ritual." },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "title_size", "label": "Header size", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "subtext_size", "label": "Subtext size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "text_color", "label": "Header color", "default": "#000000" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#40807A" },
    { "type": "color", "id": "subtext_color", "label": "Subtext color", "default": "#5F5F5F" }
  ],
  "presets": [{ "name": "Heading with eyebrow" }],
  "tag": null,
  "class": "heading-content-block"
}
{% endschema %}