{% assign pills_string = product.metafields.custom.product_pills | default: '' %}
{% assign pills_array = pills_string | split: ',' %}

<div style="
    --badge-border-radius: {{ settings.badge_corner_radius }}px;
    --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
  " class="product-pills" {{ block.shopify_attributes }}>
  {% for pill in pills_array %}
    {% assign pill_text = pill | strip %}
    {% if pill_text != '' %}
      <span class="product-pill eyebrow color-{{ settings.badge_sold_out_color_scheme }}">{{ pill_text | escape }}</span>
    {% endif %}
  {% endfor %}
</div>

{% stylesheet %}
  .product-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .product-pill {
    --badge-font-size: var(--font-size--xs);
    --color: var(--color);

    padding: 4px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-foreground);
    background: var(--color-background);
    font-size: var(--badge-font-size);
    font-family: var(--badge-font-family);
    font-weight: var(--badge-font-weight);
    text-transform: var(--badge-text-transform);
    border-radius: var(--badge-border-radius);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product pills",
  "settings": [],
  "presets": [
    {
      "name": "Product pills",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
