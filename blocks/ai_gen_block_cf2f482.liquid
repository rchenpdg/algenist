{% doc %}
  @prompt
    text slider with eyebrows, titles, subtexts. text color, size, alignment and position configurable. being able to add in more text slide. have a small product card around the bottom corner, configurable to be left or right, text shouldn't cover featured product. product in the corner, option to select bottom right or bottom left. option to have CTA on featured product., text should go around the featured product, sliding dot move to below the featured product card and center aligned to the product card. when feature product not available, center aligned to the text box container. ability to have CTA as a link (show text with underline), ability to configure featured product's background shadow opacity. ability to configure text margin to the edges of the container., remove any padding and margin of the text around product container to its outside container, be able to select border color for product card. be able to change text vertical position, ability to add up to 5 text slide, keep everything we have, add in the ability to add up to 5 text slide, keep everything we have, add in slider dot's color configuration (fill color, border color, inactive color)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-text-slider-{{ ai_gen_id }}{display:block;position:relative;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;height:{{ block.settings.height }}px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};overflow:hidden}.ai-text-slider-{{ ai_gen_id }}__content{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:{{ block.settings.text_vertical_position }};align-items:{{ block.settings.text_alignment }};text-align:{{ block.settings.text_alignment }};padding:0 {{ block.settings.text_edge_margin }}px 180px;margin:0;box-sizing:border-box}.ai-text-slider-{{ ai_gen_id }}__slide{display:none;max-width:{{ block.settings.content_width }}px}.ai-text-slider-{{ ai_gen_id }}__slide.active{display:block}.ai-text-slider-{{ ai_gen_id }} h2,.ai-text-slider-{{ ai_gen_id }} p{margin:0;padding:0}.ai-text-slider-{{ ai_gen_id }}__eyebrow{margin-bottom:12px!important;color:{{ block.settings.eyebrow_color }};font-size:{{ block.settings.eyebrow_size }}px;text-transform:uppercase;letter-spacing:.14em}.ai-text-slider-{{ ai_gen_id }}__title{font-size:{{ block.settings.title_size }}px;line-height:1.05}.ai-text-slider-{{ ai_gen_id }}__subtext{margin-top:14px!important;font-size:{{ block.settings.subtext_size }}px;line-height:1.5}.ai-text-slider-{{ ai_gen_id }}__card{position:absolute;bottom:54px;{% if block.settings.product_position == 'left' %}left:22px{% else %}right:22px{% endif %};display:flex;align-items:center;gap:12px;width:260px;max-width:calc(100% - 44px);padding:10px;margin:0;box-sizing:border-box;background:{{ block.settings.card_background }};color:{{ block.settings.card_text_color }};border:1px solid {{ block.settings.card_border_color }};border-radius:{{ block.settings.card_radius }}px;box-shadow:0 5px 18px rgba(0,0,0,{{ block.settings.card_shadow_opacity | divided_by: 100.0 }});z-index:2}.ai-text-slider-{{ ai_gen_id }}__card img{width:52px;height:52px;object-fit:cover}.ai-text-slider-{{ ai_gen_id }}__card a{display:block;margin-top:6px;color:{{ block.settings.cta_text_color }};text-decoration:underline}.ai-text-slider-{{ ai_gen_id }}__dots{position:absolute;bottom:20px;{% if block.settings.product != blank %}{% if block.settings.product_position == 'left' %}left:22px{% else %}right:22px{% endif %};width:260px{% else %}left:50%;transform:translateX(-50%){% endif %};display:flex;justify-content:center;gap:8px;margin:0;padding:0}.ai-text-slider-{{ ai_gen_id }}__dot{width:9px;height:9px;padding:0;border:1px solid {{ block.settings.dot_border_color }};border-radius:50%;background:{{ block.settings.dot_inactive_color }};cursor:pointer}.ai-text-slider-{{ ai_gen_id }}__dot.active{background:{{ block.settings.dot_fill_color }}}@media(max-width:749px){.ai-text-slider-{{ ai_gen_id }}{height:{{ block.settings.mobile_height }}px}.ai-text-slider-{{ ai_gen_id }}__content{padding-left:{{ block.settings.mobile_edge_margin }}px;padding-right:{{ block.settings.mobile_edge_margin }}px;padding-bottom:175px}.ai-text-slider-{{ ai_gen_id }}__title{font-size:{{ block.settings.mobile_title_size }}px}}{% endstyle %}<text-slider-{{ ai_gen_id }} class="ai-text-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-text-slider-{{ ai_gen_id }}__content">{% for i in (1..5) %}{% assign eyebrow_key='slide_' | append:i | append:'_eyebrow' %}{% assign title_key='slide_' | append:i | append:'_title' %}{% assign subtext_key='slide_' | append:i | append:'_subtext' %}{% if block.settings[title_key] != blank or block.settings[subtext_key] != blank %}<div class="ai-text-slider-{{ ai_gen_id }}__slide{% if i == 1 %} active{% endif %}" data-slide="{{ i }}">{% if block.settings[eyebrow_key] != blank %}<p class="ai-text-slider-{{ ai_gen_id }}__eyebrow">{{ block.settings[eyebrow_key] }}</p>{% endif %}<h2 class="ai-text-slider-{{ ai_gen_id }}__title">{{ block.settings[title_key] }}</h2><p class="ai-text-slider-{{ ai_gen_id }}__subtext">{{ block.settings[subtext_key] }}</p></div>{% endif %}{% endfor %}</div>{% if block.settings.product != blank %}{% assign product=block.settings.product %}<div class="ai-text-slider-{{ ai_gen_id }}__card">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="52" height="52">{% endif %}<span>{{ product.title }}<br>{{ product.price | money }}{% if block.settings.show_cta %}<a href="{{ product.url }}">{{ block.settings.cta_label }}</a>{% endif %}</span></div>{% endif %}<div class="ai-text-slider-{{ ai_gen_id }}__dots">{% for i in (1..5) %}<button type="button" class="ai-text-slider-{{ ai_gen_id }}__dot{% if i == 1 %} active{% endif %}" data-slide-button="{{ i }}" aria-label="Go to slide {{ i }}"></button>{% endfor %}</div></text-slider-{{ ai_gen_id }}><script>(function(){class Slider{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.slides=this.querySelectorAll('[data-slide]');this.buttons=this.querySelectorAll('[data-slide-button]');this.buttons.forEach((b)=>b.addEventListener('click',()=>{this.slides.forEach((s)=>s.classList.toggle('active',s.dataset.slide===b.dataset.slideButton));this.buttons.forEach((x)=>x.classList.toggle('active',x===b))}))}}customElements.define('text-slider-{{ ai_gen_id }}',Slider{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Text slider","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"height","label":"Height","min":240,"max":800,"step":20,"unit":"px","default":480},{"type":"range","id":"mobile_height","label":"Mobile height","min":240,"max":700,"step":20,"unit":"px","default":420},{"type":"select","id":"text_vertical_position","label":"Text vertical position","options":[{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}],"default":"center"},{"type":"range","id":"text_edge_margin","label":"Text edge margin","min":0,"max":160,"step":10,"unit":"px","default":0},{"type":"range","id":"mobile_edge_margin","label":"Mobile edge margin","min":0,"max":60,"step":5,"unit":"px","default":0},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}],"default":"center"},{"type":"range","id":"content_width","label":"Text width","min":280,"max":900,"step":20,"unit":"px","default":560},{"type":"product","id":"product","label":"Featured product"},{"type":"select","id":"product_position","label":"Product position","options":[{"value":"left","label":"Bottom left"},{"value":"right","label":"Bottom right"}],"default":"right"},{"type":"checkbox","id":"show_cta","label":"Show CTA","default":true},{"type":"text","id":"cta_label","label":"CTA label","default":"Shop now"},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":24,"step":2,"unit":"px","default":8},{"type":"range","id":"card_shadow_opacity","label":"Card shadow opacity","min":0,"max":100,"step":5,"unit":"%","default":15},{"type":"color","id":"card_border_color","label":"Card border","default":"#DCDCDC"},{"type":"color","id":"background_color","label":"Background","default":"#F9F7F6"},{"type":"color","id":"text_color","label":"Text","default":"#000000"},{"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#40807A"},{"type":"color","id":"card_background","label":"Card background","default":"#FFFFFF"},{"type":"color","id":"card_text_color","label":"Card text","default":"#000000"},{"type":"color","id":"cta_text_color","label":"CTA text","default":"#000000"},{"type":"color","id":"dot_fill_color","label":"Dot fill color","default":"#000000"},{"type":"color","id":"dot_border_color","label":"Dot border color","default":"#000000"},{"type":"color","id":"dot_inactive_color","label":"Inactive dot color","default":"transparent"},{"type":"range","id":"eyebrow_size","label":"Eyebrow size","min":10,"max":24,"step":1,"unit":"px","default":12},{"type":"range","id":"title_size","label":"Title size","min":24,"max":96,"step":2,"unit":"px","default":56},{"type":"range","id":"mobile_title_size","label":"Mobile title size","min":20,"max":56,"step":2,"unit":"px","default":36},{"type":"range","id":"subtext_size","label":"Subtext size","min":12,"max":28,"step":1,"unit":"px","default":16},{"type":"header","content":"Slides"},{"type":"text","id":"slide_1_eyebrow","label":"Slide 1 eyebrow","default":"New collection"},{"type":"text","id":"slide_1_title","label":"Slide 1 title","default":"Discover something beautiful"},{"type":"textarea","id":"slide_1_subtext","label":"Slide 1 subtext","default":"Thoughtfully made essentials for your daily ritual."},{"type":"text","id":"slide_2_eyebrow","label":"Slide 2 eyebrow","default":"A daily ritual"},{"type":"text","id":"slide_2_title","label":"Slide 2 title","default":"Carefully crafted for you"},{"type":"textarea","id":"slide_2_subtext","label":"Slide 2 subtext","default":"Simple formulas, considered results."},{"type":"text","id":"slide_3_eyebrow","label":"Slide 3 eyebrow","default":"Meet the essentials"},{"type":"text","id":"slide_3_title","label":"Slide 3 title","default":"Your new favorites"},{"type":"textarea","id":"slide_3_subtext","label":"Slide 3 subtext","default":"Elevate every moment with thoughtful care."},{"type":"text","id":"slide_4_eyebrow","label":"Slide 4 eyebrow","default":"Made with intention"},{"type":"text","id":"slide_4_title","label":"Slide 4 title","default":"Beauty in every detail"},{"type":"textarea","id":"slide_4_subtext","label":"Slide 4 subtext","default":"Discover a better way to care for your skin."},{"type":"text","id":"slide_5_eyebrow","label":"Slide 5 eyebrow","default":"Explore more"},{"type":"text","id":"slide_5_title","label":"Slide 5 title","default":"Find your ritual"},{"type":"textarea","id":"slide_5_subtext","label":"Slide 5 subtext","default":"Shop the collection today."}],"presets":[{"name":"Text slider"}],"tag":null,"class":"text-slider-block"}{% endschema %}