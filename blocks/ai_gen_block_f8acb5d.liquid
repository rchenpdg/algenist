{% doc %}
  @prompt
    create an editorial block where block size is same ratio as image uploaded, desktop and mobile image separate. desktop has left and right block and left aligned. mobile stacked. be able to select text size, text color. both sides have eyebrows, title, subtext, and bullet point text divided by thin divider line, bullet point gap configurable, be able to only upload one image on desktop spread across the block. be able to select the text container position (top, center, bottom), ability to choose text alignment (left, middle, right). block have the option to be clickable and add cta (optional), ability to have different text position and alignment for left and right panel, different alignment and position for desktop and mobile, the block should be same width as the section, extend to the edge of browsers. margin 0 0 px, make divider thinner. option to have right or/and left CTA, different links, and option to have CTA as button rather than link, color configurable, able to change text and background color for CTA hoverover state, and border color
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-editorial-{{ ai_gen_id }}{display:block;width:100%;margin:0}.ai-editorial-{{ ai_gen_id }}__frame{width:100vw;margin:0 calc(50% - 50vw);position:relative;overflow:hidden;aspect-ratio:{{ block.settings.desktop_image.aspect_ratio | default: 1 }}}.ai-editorial-{{ ai_gen_id }}__image,.ai-editorial-{{ ai_gen_id }}__placeholder{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.ai-editorial-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center}.ai-editorial-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-editorial-{{ ai_gen_id }}__overlay{position:absolute;inset:0;background:rgba(0,0,0,.42)}.ai-editorial-{{ ai_gen_id }}__grid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(2,1fr);height:100%;color:{{ block.settings.text_color }}}.ai-editorial-{{ ai_gen_id }}__content{align-self:{{ block.settings.desktop_position_1 }};padding:clamp(24px,5vw,64px);text-align:{{ block.settings.desktop_alignment_1 }}}.ai-editorial-{{ ai_gen_id }}__content--2{align-self:{{ block.settings.desktop_position_2 }};text-align:{{ block.settings.desktop_alignment_2 }}}.ai-editorial-{{ ai_gen_id }}__eyebrow{margin:0 0 12px;color:{{ block.settings.eyebrow_color }};font-size:{{ block.settings.eyebrow_size }}px;text-transform:uppercase;letter-spacing:.12em}.ai-editorial-{{ ai_gen_id }}__title{margin:0;font-size:{{ block.settings.title_size }}px;line-height:1.05}.ai-editorial-{{ ai_gen_id }}__subtext{margin:16px 0;font-size:{{ block.settings.subtext_size }}px}.ai-editorial-{{ ai_gen_id }}__bullets{margin:24px 0 0;padding:0;list-style:none}.ai-editorial-{{ ai_gen_id }}__bullet{padding:{{ block.settings.bullet_gap }}px 0;border-top:.5px solid {{ block.settings.divider_color }};font-size:{{ block.settings.bullet_size }}px}.ai-editorial-{{ ai_gen_id }}__bullet:last-child{border-bottom:.5px solid {{ block.settings.divider_color }}}.ai-editorial-{{ ai_gen_id }}__cta{display:inline-block;margin-top:24px;padding:10px 0;border:1px solid {{ block.settings.cta_border_color }};color:{{ block.settings.cta_color }};font-size:{{ block.settings.cta_size }}px;text-decoration:underline;text-underline-offset:4px;transition:color .2s ease,background-color .2s ease,border-color .2s ease}.ai-editorial-{{ ai_gen_id }}__cta--button{padding:12px 22px;border-radius:{{ block.settings.cta_radius }}px;background:{{ block.settings.cta_background }};color:{{ block.settings.cta_button_text }};text-decoration:none}.ai-editorial-{{ ai_gen_id }}__cta:hover{color:{{ block.settings.cta_hover_color }};background:{{ block.settings.cta_hover_background }};border-color:{{ block.settings.cta_hover_border_color }}}.ai-editorial-{{ ai_gen_id }}__link{display:block;width:100%;color:inherit;text-decoration:none}@media(max-width:749px){.ai-editorial-{{ ai_gen_id }}__frame{aspect-ratio:{{ block.settings.mobile_image.aspect_ratio | default: 1 }}}.ai-editorial-{{ ai_gen_id }}__desktop-image{display:none}.ai-editorial-{{ ai_gen_id }}__grid{grid-template-columns:1fr;height:auto;min-height:100%}.ai-editorial-{{ ai_gen_id }}__content{align-self:{{ block.settings.mobile_position_1 }};text-align:{{ block.settings.mobile_alignment_1 }};min-height:50%}.ai-editorial-{{ ai_gen_id }}__content--2{align-self:{{ block.settings.mobile_position_2 }};text-align:{{ block.settings.mobile_alignment_2 }}}}@media(min-width:750px){.ai-editorial-{{ ai_gen_id }}__mobile-image{display:none}}
{% endstyle %}
<div class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{% if block.settings.enable_clickable and block.settings.block_link != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.block_link }}">{% endif %}<div class="ai-editorial-{{ ai_gen_id }}__frame">{% if block.settings.desktop_image %}<img class="ai-editorial-{{ ai_gen_id }}__image ai-editorial-{{ ai_gen_id }}__desktop-image" src="{{ block.settings.desktop_image | image_url: width:2400 }}" alt="{{ block.settings.desktop_image.alt | escape }}" loading="lazy">{% else %}<div class="ai-editorial-{{ ai_gen_id }}__placeholder ai-editorial-{{ ai_gen_id }}__desktop-image">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}{% if block.settings.mobile_image %}<img class="ai-editorial-{{ ai_gen_id }}__image ai-editorial-{{ ai_gen_id }}__mobile-image" src="{{ block.settings.mobile_image | image_url: width:1600 }}" alt="{{ block.settings.mobile_image.alt | escape }}" loading="lazy">{% endif %}<div class="ai-editorial-{{ ai_gen_id }}__overlay"></div><div class="ai-editorial-{{ ai_gen_id }}__grid">{% for i in (1..2) %}{% liquid
assign eyebrow_key = 'panel_' | append: i | append: '_eyebrow'
assign title_key = 'panel_' | append: i | append: '_title'
assign subtext_key = 'panel_' | append: i | append: '_subtext'
assign bullets_key = 'panel_' | append: i | append: '_bullets'
assign cta_label_key = 'panel_' | append: i | append: '_cta_label'
assign cta_link_key = 'panel_' | append: i | append: '_cta_link'
assign bullets = block.settings[bullets_key] | newline_to_br | split: '<br />'
%}<div class="ai-editorial-{{ ai_gen_id }}__content{% if i == 2 %} ai-editorial-{{ ai_gen_id }}__content--2{% endif %}">{% if block.settings[eyebrow_key] != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings[eyebrow_key] }}</p>{% endif %}{% if block.settings[title_key] != blank %}<h2 class="ai-editorial-{{ ai_gen_id }}__title">{{ block.settings[title_key] }}</h2>{% endif %}{% if block.settings[subtext_key] != blank %}<div class="ai-editorial-{{ ai_gen_id }}__subtext">{{ block.settings[subtext_key] }}</div>{% endif %}<ul class="ai-editorial-{{ ai_gen_id }}__bullets">{% for bullet in bullets %}{% assign clean_bullet = bullet | strip %}{% if clean_bullet != blank %}<li class="ai-editorial-{{ ai_gen_id }}__bullet">{{ clean_bullet }}</li>{% endif %}{% endfor %}</ul>{% if block.settings[cta_label_key] != blank and block.settings[cta_link_key] != blank %}{% if block.settings.enable_clickable %}<span class="ai-editorial-{{ ai_gen_id }}__cta{% if block.settings.cta_style == 'button' %} ai-editorial-{{ ai_gen_id }}__cta--button{% endif %}">{{ block.settings[cta_label_key] }}</span>{% else %}<a class="ai-editorial-{{ ai_gen_id }}__cta{% if block.settings.cta_style == 'button' %} ai-editorial-{{ ai_gen_id }}__cta--button{% endif %}" href="{{ block.settings[cta_link_key] }}">{{ block.settings[cta_label_key] }}</a>{% endif %}{% endif %}</div>{% endfor %}</div></div>{% if block.settings.enable_clickable and block.settings.block_link != blank %}</a>{% endif %}</div>
{% schema %}{"name":"Editorial split","settings":[{"type":"image_picker","id":"desktop_image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"checkbox","id":"enable_clickable","label":"Make block clickable","default":false},{"type":"url","id":"block_link","label":"Block link"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#ffffff"},{"type":"color","id":"divider_color","label":"Divider","default":"#ffffff"},{"type":"color","id":"cta_color","label":"CTA text","default":"#ffffff"},{"type":"color","id":"cta_background","label":"Button background","default":"#40807a"},{"type":"color","id":"cta_button_text","label":"Button text","default":"#ffffff"},{"type":"color","id":"cta_border_color","label":"CTA border","default":"#ffffff"},{"type":"color","id":"cta_hover_color","label":"Hover text","default":"#ffffff"},{"type":"color","id":"cta_hover_background","label":"Hover background","default":"#2d5a55"},{"type":"color","id":"cta_hover_border_color","label":"Hover border","default":"#ffffff"},{"type":"select","id":"cta_style","label":"CTA style","options":[{"value":"link","label":"Link"},{"value":"button","label":"Button"}],"default":"link"},{"type":"range","id":"cta_radius","label":"Button radius","min":0,"max":40,"step":2,"unit":"px","default":4},{"type":"range","id":"eyebrow_size","label":"Eyebrow size","min":10,"max":24,"step":1,"unit":"px","default":12},{"type":"range","id":"title_size","label":"Title size","min":20,"max":72,"step":2,"unit":"px","default":40},{"type":"range","id":"subtext_size","label":"Subtext size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"bullet_size","label":"Bullet size","min":12,"max":24,"step":1,"unit":"px","default":15},{"type":"range","id":"bullet_gap","label":"Bullet gap","min":4,"max":32,"step":2,"unit":"px","default":12},{"type":"range","id":"cta_size","label":"CTA size","min":12,"max":24,"step":1,"unit":"px","default":15},{"type":"header","content":"Left panel"},{"type":"text","id":"panel_1_eyebrow","label":"Eyebrow","default":"Discover"},{"type":"text","id":"panel_1_title","label":"Title","default":"A considered ritual"},{"type":"textarea","id":"panel_1_subtext","label":"Subtext","default":"Thoughtful formulas designed for your daily routine."},{"type":"textarea","id":"panel_1_bullets","label":"Bullet points","default":"Clinically tested\nMade with intention"},{"type":"text","id":"panel_1_cta_label","label":"CTA label","default":"Explore left"},{"type":"url","id":"panel_1_cta_link","label":"CTA link"},{"type":"header","content":"Right panel"},{"type":"text","id":"panel_2_eyebrow","label":"Eyebrow","default":"The collection"},{"type":"text","id":"panel_2_title","label":"Title","default":"Beauty, refined"},{"type":"textarea","id":"panel_2_subtext","label":"Subtext","default":"Elevated essentials for every day."},{"type":"textarea","id":"panel_2_bullets","label":"Bullet points","default":"Powerful ingredients\nComfortable textures"},{"type":"text","id":"panel_2_cta_label","label":"CTA label","default":"Explore right"},{"type":"url","id":"panel_2_cta_link","label":"CTA link"},{"type":"select","id":"desktop_position_1","label":"Left desktop position","options":[{"value":"start","label":"Top"},{"value":"center","label":"Center"},{"value":"end","label":"Bottom"}],"default":"end"},{"type":"select","id":"desktop_alignment_1","label":"Left desktop alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Middle"},{"value":"right","label":"Right"}],"default":"left"},{"type":"select","id":"desktop_position_2","label":"Right desktop position","options":[{"value":"start","label":"Top"},{"value":"center","label":"Center"},{"value":"end","label":"Bottom"}],"default":"end"},{"type":"select","id":"desktop_alignment_2","label":"Right desktop alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Middle"},{"value":"right","label":"Right"}],"default":"left"},{"type":"select","id":"mobile_position_1","label":"Left mobile position","options":[{"value":"start","label":"Top"},{"value":"center","label":"Center"},{"value":"end","label":"Bottom"}],"default":"start"},{"type":"select","id":"mobile_alignment_1","label":"Left mobile alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Middle"},{"value":"right","label":"Right"}],"default":"left"},{"type":"select","id":"mobile_position_2","label":"Right mobile position","options":[{"value":"start","label":"Top"},{"value":"center","label":"Center"},{"value":"end","label":"Bottom"}],"default":"start"},{"type":"select","id":"mobile_alignment_2","label":"Right mobile alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Middle"},{"value":"right","label":"Right"}],"default":"left"}],"presets":[{"name":"Editorial split"}],"tag":null,"class":"editorial-split-block"}{% endschema %}