{% doc %}
  @prompt
    Create a responsive image banner theme block inspired by the attached reference image: https://sidekick.shopify.ai/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6Mzc5OTk3NDM2MSwicHVyIjoiYmxvYl9pZCJ9fQ==--f503b6509eccf12a804bcacc0721cd8499d478ba/image.png. The block should support separate desktop and mobile images, and each image must display at its natural uploaded aspect ratio without forcing a fixed banner ratio. Add configurable eyebrow text, title text, and subtext content. Provide controls for the title and subtext font sizes and colors, plus the eyebrow color. Add a configurable CTA with button text, link, text color, background color, border color, hover background color, and border radius. Provide separate desktop and mobile controls for the title text alignment and content position, and separate desktop and mobile controls for the CTA text alignment and position. Keep the visual treatment close to the reference: image-led banner with readable overlaid text and CTA, with sensible contrast defaults and responsive behavior., CTA container position should be right after subtext container. All container shouldn't be out of the visible range. right now if we do right  bottom align, text is out of the visible range.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{%- liquid
  assign cta_visible_label = block.settings.cta_text | strip
  assign cta_label_key = cta_visible_label | downcase
  assign cta_slug = block.settings.cta_link | split: '?' | first | split: '/' | last | replace: '-', ' ' | strip
  assign cta_accessible_name = cta_visible_label
  if cta_slug != blank
    if cta_label_key == 'shop now' or cta_label_key == 'shop' or cta_label_key == 'shop best sellers' or cta_label_key == 'learn more' or cta_label_key == 'read more' or cta_label_key == 'discover' or cta_label_key == 'shop all' or cta_label_key == 'view all' or cta_label_key == 'get started'
      assign cta_accessible_name = cta_visible_label | append: ', ' | append: cta_slug
    endif
  endif
  assign banner_image_alt = block.settings.desktop_image.alt | default: block.settings.mobile_image.alt | default: block.settings.title | escape
-%}

{% style %}
  .ai-image-banner-{{ ai_gen_id }}{display:block;position:relative;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;overflow:hidden}
  .ai-image-banner-{{ ai_gen_id }}__media,.ai-image-banner-{{ ai_gen_id }}__media img{display:block;width:100%;height:auto}
  .ai-image-banner-{{ ai_gen_id }}__media{position:relative;background:#e9e6e2}
  .ai-image-banner-{{ ai_gen_id }}__media:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.52),rgba(0,0,0,.06) 75%);pointer-events:none}
  .ai-image-banner-{{ ai_gen_id }}__placeholder{aspect-ratio:16/7;display:flex;align-items:center;justify-content:center;color:#555}
  .ai-image-banner-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}
  .ai-image-banner-{{ ai_gen_id }}__layer{position:absolute;inset:0;z-index:1;pointer-events:none}
  .ai-image-banner-{{ ai_gen_id }}__content{position:absolute;top:{% if block.settings.title_vertical == 'top' %}8%{% elsif block.settings.title_vertical == 'center' %}50%{% else %}92%{% endif %};left:{% if block.settings.title_horizontal == 'left' %}7%{% elsif block.settings.title_horizontal == 'center' %}50%{% else %}93%{% endif %};width:min(42%,520px);transform:translate({% if block.settings.title_horizontal == 'center' %}-50%{% elsif block.settings.title_horizontal == 'right' %}-100%{% else %}0{% endif %},{% if block.settings.title_vertical == 'center' %}-50%{% elsif block.settings.title_vertical == 'bottom' %}-100%{% else %}0{% endif %});text-align:{{ block.settings.title_alignment }};pointer-events:auto}
  .ai-image-banner-{{ ai_gen_id }}__eyebrow{margin:0 0 12px;color:{{ block.settings.eyebrow_color }};font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:700}
  .ai-image-banner-{{ ai_gen_id }}__title{margin:0;color:{{ block.settings.title_color }};font-size:{{ block.settings.title_size }}px;line-height:1.05;font-weight:500}
  .ai-image-banner-{{ ai_gen_id }}__subtext{margin:16px 0 0;color:{{ block.settings.subtext_color }};font-size:{{ block.settings.subtext_size }}px;line-height:1.45}
  .ai-image-banner-{{ ai_gen_id }}__cta{display:block;margin-top:22px;text-align:{{ block.settings.cta_alignment }};width:100%}
  .ai-image-banner-{{ ai_gen_id }}__button{display:inline-block;padding:13px 24px;color:{{ block.settings.cta_text_color }};background:{{ block.settings.cta_background }};border:1px solid {{ block.settings.cta_border_color }};border-radius:{{ block.settings.cta_radius }}px;text-decoration:none;font-size:14px;font-weight:700;transition:background-color .2s ease}
  .ai-image-banner-{{ ai_gen_id }}__button:hover{background:{{ block.settings.cta_hover_background }}}
  @media screen and (max-width:749px){
    .ai-image-banner-{{ ai_gen_id }}{width:100%}.ai-image-banner-{{ ai_gen_id }}__media:after{background:linear-gradient(90deg,rgba(0,0,0,.55),rgba(0,0,0,.08))}
    .ai-image-banner-{{ ai_gen_id }}__content{width:84%;top:{% if block.settings.mobile_title_vertical == 'top' %}8%{% elsif block.settings.mobile_title_vertical == 'center' %}50%{% else %}92%{% endif %};left:{% if block.settings.mobile_title_horizontal == 'left' %}8%{% elsif block.settings.mobile_title_horizontal == 'center' %}50%{% else %}92%{% endif %};transform:translate({% if block.settings.mobile_title_horizontal == 'center' %}-50%{% elsif block.settings.mobile_title_horizontal == 'right' %}-100%{% else %}0{% endif %},{% if block.settings.mobile_title_vertical == 'center' %}-50%{% elsif block.settings.mobile_title_vertical == 'bottom' %}-100%{% else %}0{% endif %});text-align:{{ block.settings.mobile_title_alignment }};}
    .ai-image-banner-{{ ai_gen_id }}__cta{text-align:{{ block.settings.mobile_cta_alignment }}}
    .ai-image-banner-{{ ai_gen_id }}__title{font-size:{{ block.settings.mobile_title_size }}px}.ai-image-banner-{{ ai_gen_id }}__subtext{font-size:{{ block.settings.mobile_subtext_size }}px}
  }
{% endstyle %}

<div class="ai-image-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-banner-{{ ai_gen_id }}__media">
    {% if block.settings.desktop_image or block.settings.mobile_image %}
      <picture>
        {% if block.settings.mobile_image %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 1200 }}">{% endif %}
        {% if block.settings.desktop_image %}<img src="{{ block.settings.desktop_image | image_url: width: 2400 }}" alt="{{ banner_image_alt }}" loading="lazy" width="{{ block.settings.desktop_image.width }}" height="{{ block.settings.desktop_image.height }}">{% else %}<img src="{{ block.settings.mobile_image | image_url: width: 1200 }}" alt="{{ banner_image_alt }}" loading="lazy" width="{{ block.settings.mobile_image.width }}" height="{{ block.settings.mobile_image.height }}">{% endif %}
      </picture>
    {% else %}<div class="ai-image-banner-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
    <div class="ai-image-banner-{{ ai_gen_id }}__layer"><div class="ai-image-banner-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}<p class="ai-image-banner-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
      {% if block.settings.title != blank %}<h1 class="ai-image-banner-{{ ai_gen_id }}__title">{{ block.settings.title }}</h1>{% endif %}
      {% if block.settings.subtext != blank %}<p class="ai-image-banner-{{ ai_gen_id }}__subtext">{{ block.settings.subtext | newline_to_br }}</p>{% endif %}
      {% if block.settings.cta_text != blank and block.settings.cta_link != blank %}<div class="ai-image-banner-{{ ai_gen_id }}__cta"><a class="ai-image-banner-{{ ai_gen_id }}__button" href="{{ block.settings.cta_link }}"{% if cta_accessible_name != cta_visible_label %} aria-label="{{ cta_accessible_name | escape }}"{% endif %}>{{ block.settings.cta_text | escape }}</a></div>{% endif %}
    </div></div>
  </div>
</div>

