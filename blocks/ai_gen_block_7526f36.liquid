{% doc %}
  @prompt
    i want to build the hero section that is on https://themarabeauty.com/, i really like this block but i want to have the option to put the text under the image and also have mobile options of placement. , keep this block add a mobile image section to it. , double check work and fix the text overlay on mobile and make the image full bleed and bigger then the text section on mobile. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
    overflow: hidden;
  }

  .ai-hero-{{ ai_gen_id }}.layout-overlay {
    min-height: {{ block.settings.min_height_desktop }}px;
  }

  .ai-hero-{{ ai_gen_id }}.layout-stacked {
    min-height: auto;
  }

  .ai-hero-background-{{ ai_gen_id }} {
    width: 100%;
    z-index: 1;
  }

  .ai-hero-{{ ai_gen_id }}.layout-overlay .ai-hero-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
  }

  .ai-hero-{{ ai_gen_id }}.layout-stacked .ai-hero-background-{{ ai_gen_id }} {
    position: relative;
    height: auto;
  }

  .ai-hero-background-{{ ai_gen_id }} img {
    width: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position_desktop }};
  }

  .ai-hero-{{ ai_gen_id }}.layout-overlay .ai-hero-background-{{ ai_gen_id }} img {
    height: 100%;
  }

  .ai-hero-{{ ai_gen_id }}.layout-stacked .ai-hero-background-{{ ai_gen_id }} img {
    height: auto;
    min-height: {{ block.settings.stacked_image_height_desktop }}px;
  }

  .ai-hero-background-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-hero-background-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-hero-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-{{ ai_gen_id }}.layout-overlay .ai-hero-background-placeholder-{{ ai_gen_id }} {
    height: 100%;
  }

  .ai-hero-{{ ai_gen_id }}.layout-stacked .ai-hero-background-placeholder-{{ ai_gen_id }} {
    min-height: {{ block.settings.stacked_image_height_desktop }}px;
  }

  .ai-hero-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-hero-content-wrapper-{{ ai_gen_id }} {
    z-index: 3;
    width: 100%;
    display: flex;
    align-items: {{ block.settings.content_vertical_alignment_desktop }};
    justify-content: {{ block.settings.content_horizontal_alignment_desktop }};
    padding: 40px 20px;
  }

  .ai-hero-{{ ai_gen_id }}.layout-overlay .ai-hero-content-wrapper-{{ ai_gen_id }} {
    position: relative;
    min-height: {{ block.settings.min_height_desktop }}px;
  }

  .ai-hero-{{ ai_gen_id }}.layout-stacked .ai-hero-content-wrapper-{{ ai_gen_id }} {
    position: relative;
    min-height: auto;
  }

  .ai-hero-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    text-align: {{ block.settings.text_alignment_desktop }};
    color: {{ block.settings.text_color }};
  }

  .ai-hero-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-hero-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.5;
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
  }

  .ai-hero-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    {% if block.settings.text_alignment_desktop == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment_desktop == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .ai-hero-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-hero-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.primary_button_border }};
  }

  .ai-hero-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_bg }};
    color: {{ block.settings.primary_button_hover_color }};
    border-color: {{ block.settings.primary_button_hover_border }};
  }

  .ai-hero-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.secondary_button_bg }};
    color: {{ block.settings.secondary_button_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.secondary_button_border }};
  }

  .ai-hero-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover_bg }};
    color: {{ block.settings.secondary_button_hover_color }};
    border-color: {{ block.settings.secondary_button_hover_border }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-{{ ai_gen_id }}.layout-overlay-mobile {
      min-height: {{ block.settings.min_height_mobile }}px;
    }

    .ai-hero-{{ ai_gen_id }}.layout-stacked-mobile {
      min-height: auto;
    }

    .ai-hero-{{ ai_gen_id }}.layout-overlay-mobile .ai-hero-background-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
    }

    .ai-hero-{{ ai_gen_id }}.layout-stacked-mobile .ai-hero-background-{{ ai_gen_id }} {
      position: relative;
      height: auto;
      width: 100%;
    }

    .ai-hero-{{ ai_gen_id }}.layout-overlay-mobile .ai-hero-background-{{ ai_gen_id }} img {
      height: 100%;
      width: 100%;
      object-fit: cover;
    }

    .ai-hero-{{ ai_gen_id }}.layout-stacked-mobile .ai-hero-background-{{ ai_gen_id }} img {
      height: auto;
      width: 100%;
      min-height: {{ block.settings.stacked_image_height_mobile }}px;
      object-fit: cover;
    }

    .ai-hero-{{ ai_gen_id }}.layout-overlay-mobile .ai-hero-background-placeholder-{{ ai_gen_id }} {
      height: 100%;
      width: 100%;
    }

    .ai-hero-{{ ai_gen_id }}.layout-stacked-mobile .ai-hero-background-placeholder-{{ ai_gen_id }} {
      min-height: {{ block.settings.stacked_image_height_mobile }}px;
      width: 100%;
    }

    .ai-hero-background-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-background-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-content-wrapper-{{ ai_gen_id }} {
      padding: 30px 16px;
      align-items: {{ block.settings.content_vertical_alignment_mobile }};
      justify-content: {{ block.settings.content_horizontal_alignment_mobile }};
    }

    .ai-hero-{{ ai_gen_id }}.layout-overlay-mobile .ai-hero-content-wrapper-{{ ai_gen_id }} {
      position: relative;
      min-height: {{ block.settings.min_height_mobile }}px;
    }

    .ai-hero-{{ ai_gen_id }}.layout-stacked-mobile .ai-hero-content-wrapper-{{ ai_gen_id }} {
      position: relative;
      min-height: auto;
    }

    .ai-hero-content-{{ ai_gen_id }} {
      text-align: {{ block.settings.text_alignment_mobile }};
    }

    .ai-hero-background-{{ ai_gen_id }} img {
      object-position: {{ block.settings.image_position_mobile }};
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-hero-eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size | times: 0.85 }}px;
    }

    .ai-hero-buttons-{{ ai_gen_id }} {
      {% if block.settings.text_alignment_mobile == 'center' %}
        justify-content: center;
      {% elsif block.settings.text_alignment_mobile == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    {% if block.settings.mobile_buttons_full_width %}
      .ai-hero-buttons-{{ ai_gen_id }} {
        flex-direction: column;
        width: 100%;
      }

      .ai-hero-button-{{ ai_gen_id }} {
        width: 100%;
      }
    {% endif %}
  }
{% endstyle %}

<hero-section-{{ ai_gen_id }}
  class="ai-hero-{{ ai_gen_id }} layout-{{ block.settings.desktop_layout }} layout-{{ block.settings.mobile_layout }}-mobile"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-background-{{ ai_gen_id }}">
    <div class="ai-hero-background-desktop-{{ ai_gen_id }}">
      {% if block.settings.background_image %}
        <img
          src="{{ block.settings.background_image | image_url: width: 2000 }}"
          srcset="{{ block.settings.background_image | image_url: width: 750 }} 750w,
                  {{ block.settings.background_image | image_url: width: 1500 }} 1500w,
                  {{ block.settings.background_image | image_url: width: 2000 }} 2000w"
          sizes="100vw"
          alt="{{ block.settings.background_image.alt | escape }}"
          loading="eager"
          width="{{ block.settings.background_image.width }}"
          height="{{ block.settings.background_image.height }}"
        >
      {% else %}
        <div class="ai-hero-background-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-hero-empty-state-{{ ai_gen_id }}">
            Next, add a background image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-hero-background-mobile-{{ ai_gen_id }}">
      {% if block.settings.mobile_background_image %}
        <img
          src="{{ block.settings.mobile_background_image | image_url: width: 1000 }}"
          srcset="{{ block.settings.mobile_background_image | image_url: width: 500 }} 500w,
                  {{ block.settings.mobile_background_image | image_url: width: 750 }} 750w,
                  {{ block.settings.mobile_background_image | image_url: width: 1000 }} 1000w"
          sizes="100vw"
          alt="{{ block.settings.mobile_background_image.alt | escape }}"
          loading="eager"
          width="{{ block.settings.mobile_background_image.width }}"
          height="{{ block.settings.mobile_background_image.height }}"
        >
      {% elsif block.settings.background_image %}
        <img
          src="{{ block.settings.background_image | image_url: width: 1000 }}"
          srcset="{{ block.settings.background_image | image_url: width: 500 }} 500w,
                  {{ block.settings.background_image | image_url: width: 750 }} 750w,
                  {{ block.settings.background_image | image_url: width: 1000 }} 1000w"
          sizes="100vw"
          alt="{{ block.settings.background_image.alt | escape }}"
          loading="eager"
          width="{{ block.settings.background_image.width }}"
          height="{{ block.settings.background_image.height }}"
        >
      {% else %}
        <div class="ai-hero-background-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-hero-empty-state-{{ ai_gen_id }}">
            Next, add a background image
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  {% if block.settings.show_overlay %}
    <div class="ai-hero-overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-hero-content-wrapper-{{ ai_gen_id }}">
    <div class="ai-hero-content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <div class="ai-hero-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h1 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-hero-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}

      {% if block.settings.primary_button_label != blank or block.settings.secondary_button_label != blank %}
        <div class="ai-hero-buttons-{{ ai_gen_id }}">
          {% if block.settings.primary_button_label != blank %}
            <a
              href="{{ block.settings.primary_button_link }}"
              class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.primary_button_label }}
            </a>
          {% endif %}

          {% if block.settings.secondary_button_label != blank %}
            <a
              href="{{ block.settings.secondary_button_link }}"
              class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.secondary_button_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</hero-section-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('hero-section-{{ ai_gen_id }}', HeroSection{{ ai_gen_id }});
  })();
</script>

