{% liquid
  assign ingredient_image = block.settings.ingredient_image
-%}
<slideshow-slide class="scroll-trigger animate--fade-in" ref="slides[]" style="view-timeline: --slide-{{ block.index0 }};">
  <div class="ingredient-card">
    {% if ingredient_image %}
      <figure class="ingredient-card__image-wrapper">
        <img
          src="{{ ingredient_image | image_url: width: 650, height: 914 }}"
          alt="{{ block.settings.ingredient_name | escape }}"
          class="ingredient-card__image"
          width="325"
          height="457"
        >
      </figure>
    {% endif %}

    {% if block.settings.ingredient_name %}
      <p class="ingredient-card__name eyebrow">{{ block.settings.ingredient_name }}</p>
    {% endif %}

    <div class="ingredient-card__content">
      {% if block.settings.ingredient_subtitle %}
        <p class="ingredient-card__subtitle">{{ block.settings.ingredient_subtitle }}</p>
      {% endif %}

      {% if block.settings.ingredient_description %}
        <button
          class="ingredient-card__toggle-description"
          aria-expanded="false"
          aria-controls="ingredient-description-{{ block.id }}"
        >
          <span class="visually-hidden">Toggle Description</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="11.955" cy="11.955" r="11.455" stroke="#40807A"/>
            <path d="M11.1488 17V8.888H12.7648V17H11.1488ZM11.0048 7.768V5.96H12.8768V7.768H11.0048Z" fill="#40807A"/>
          </svg>
        </button>
        <div class="ingredient-card__description">{{ block.settings.ingredient_description }}</div>
      {% endif %}
    </div>
  </div>
</slideshow-slide>

{% stylesheet %}
  .ingredient-card {
    aspect-ratio: 325 / 457;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  .ingredient-card__image-wrapper {
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .ingredient-card__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .ingredient-card__name {
    background-color: #ffffff;
    border-radius: 37px;
    color: #40807a !important;
    padding: 4px 10px;
    position: absolute;
    left: 14px;
    top: 14px;
  }

  .ingredient-card__content {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    position: absolute;
    bottom: 14px;
    inset-inline: 14px;
  }

  .ingredient-card__subtitle {
    color: #5f5f5f;
    max-width: 140px;
  }

  .ingredient-card__toggle-description {
    background: none;
    border: none;
    margin-left: auto;
    padding: 0;
    cursor: pointer;
  }

  .ingredient-card__description {
    background-color: #ffffff;
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    padding: 14px;
  }

  .ingredient-card__toggle-description:hover + .ingredient-card__description {
    opacity: 1;
  }

  .ingredient-card p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredient Card",
  "blocks": [],
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "ingredient_image",
      "label": "Ingredient Image",
      "info": "Recommended: 650 x 914px"
    },
    {
      "type": "text",
      "id": "ingredient_name",
      "label": "Ingredient Name",
      "default": "Aloe Vera"
    },
    {
      "type": "text",
      "id": "ingredient_subtitle",
      "label": "Ingredient Subtitle",
      "default": "Soothing Plant Extract"
    },
    {
      "type": "textarea",
      "id": "ingredient_description",
      "label": "Ingredient Description",
      "default": "Known for its soothing and hydrating properties, Aloe Vera helps to calm irritated skin and provides deep moisture."
    }
  ],
  "presets": [
    {
      "name": "Ingredient Card",
      "category": "Ingredient"
    }
  ]
}
{% endschema %}
