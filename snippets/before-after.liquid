{%- doc -%}
    Intended for use in a block similar to the button block.

    @param {object} image_before - image before
    @param {object} image_after - image after.
    @param {number} border_radius - border radius for images
    @param {string} caption - image caption

    @example
    {% render 'button', link: '/collections/all' %}
{%- enddoc -%}
<script
  src="{{ 'image-input.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
    if image_after != blank
        assign slider_position = '50%'
    else
        assign slider_position = '100%'
    endif
-%}
<div
    style="
    --badge-border-radius: {{ settings.badge_corner_radius }}px;
    --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: 700; --badge-text-transform: {{ settings.badge_text_transform }};
    "
    class="before-after-container scroll-trigger animate--fade-in media-block"
>
    <image-input class="before-after" style="--position: {{ slider_position }};">
        <div class="before-after__image-container" style="border-radius: {{ border_radius }}px;">
            <div class="before-after__image-container--before">
                {%- if image_after != blank -%}
                    <span class="before-after__badge color-{{ settings.badge_sold_out_color_scheme }}">Before</span>
                {% endif %}
                {{ image_before | image_url: width: 1338, height: 1080, crop: 'center' | image_tag: width: 1338, loading: 'lazy', class: 'slider-image' }}
            </div>
            {% if image_after != blank %}
                <div class="before-after__image-container--after">
                    <span class="before-after__badge color-{{ settings.badge_sold_out_color_scheme }}">After</span>
                    {{ image_after | image_url: width: 1338, height: 1080, crop: 'center' | image_tag: width: 1338, loading: 'lazy', class: 'slider-image' }}
                </div>
            {%  endif %}
        </div>
        {%- if image_after != blank -%}
            <input type="range" min="0" max="1000" value="500" aria-label="Before After Slider" class="before-after__slider">
            <div class="slider-line" aria-hidden="true"> </div>
            <div class="slider-button" aria-hidden="true">
                <svg width="71" height="71" viewBox="0 0 71 71" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="35.5" cy="35.5" r="35.5" fill="white"/>
                <path d="M23.5908 28.6292L16.0915 36.1285" stroke="#40807A" stroke-width="1.5"/>
                <path d="M23.5908 43.5034L16.0915 36.0041" stroke="#40807A" stroke-width="1.5"/>
                <path d="M48.021 43.5034L55.5203 36.0041" stroke="#40807A" stroke-width="1.5"/>
                <path d="M48.021 28.6292L55.5203 36.1285" stroke="#40807A" stroke-width="1.5"/>
                </svg>
            </div>
        {%- endif -%}
    </image-input>

    {% if caption != blank and image_after != blank %}
        <div class="before-after__caption text-left">
            <span class="h5">{{ caption }}</span>
        </div>
    {% endif %}
</div>


{% stylesheet %}
    .before-after__badge {
        --badge-font-size: var(--font-size--xs);

        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: var(--badge-font-size);
        font-family: var(--badge-font-family);
        font-weight: var(--badge-font-weight);
        text-transform: var(--badge-text-transform);
        border-radius: var(--badge-border-radius);

        padding: 0.25rem 0.625rem;

        position: absolute;
        top: 1.25rem;
    }

    .before-after__image-container--before .before-after__badge {
        left: 1.25rem;
    }

    .before-after__image-container--after .before-after__badge {
        right: 1.25rem;
    }

    .before-after__caption {
        margin-top: 1.25rem;
    }

    .before-after__caption span.h5 {
        display: block;
        line-height: 1;
        font-weight: 700;
    }

    .before-after__caption span.h5 a {
        text-decoration: underline;
    }

    .before-after__image-container {
        position: relative;
        width: 100%;
        overflow: hidden;
        padding-bottom: 100%;
    }

    .before-after__image-container > * {
        position: absolute;
        inset: 0;
    }

    .before-after {
        aspect-ratio: 1;
        display: block;
        position: relative;
        overflow: hidden;
    }

    .before-after__image-container--before {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        width: var(--position);
        z-index: 1;
        overflow-x: hidden;
    }

    .before-after__image-container .slider-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .before-after__image-container .tag {
        display: block;
        position: absolute;
        top: 1rem;
    }

    .before-after__image-container--before .tag {
        left: 1rem;
        z-index: 1;
    }

    .before-after__image-container--after .tag {
        right: 1rem;
    }

    .before-after__slider {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        cursor: pointer;
        opacity: 0;
        width: 100% !important;
        height: 100% !important;
        z-index: 2;
    }

    .slider-line {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        width: 0.1rem;
        height: 100%;
        background-color: #fff;
        left: var(--position);
        transform: translate(-50%);
        pointer-events: none;
        z-index: 2;
    }

    .slider-button {
        position: absolute;
        border-radius: 100vw;
        display: grid;
        place-items: center;
        top: 50%;
        left: var(--position);
        transform: translate(-50%, -50%);
        pointer-events: none;
        z-index: 2;
        width: 100%;
        height: 100%;
    }

    .slider-button svg {
        width: 50px;
        height: 50px;
    }

    @media screen and (min-width: 750px) {
        .slider-button svg {
            width: 70px;
            height: 70px;
        }
    }
{% endstylesheet %}
