{%- doc -%}
  Renders a quick add component.

  @param {object} product - The product object
  @param {string} section_id - The section ID
  @param {object} [block] - The block object
{%- enddoc -%}

{% liquid
  assign product_form_id = 'ProductNavigation-ProductForm-' | append: product.id | append: '-' | append: block.id
  assign add_to_cart_text = 'actions.add_to_cart' | t

  assign current_variant = product.selected_or_first_available_variant

  if current_variant.available
    assign can_add_to_cart = true
  else
    assign can_add_to_cart = false
  endif
%}

<product-form-component
  data-section-id="{{ section_id }}"
  data-product-id="{{ product.id }}"
  on:submit="/handleSubmit"
  class="product-nav__product-form-component"
>
  <div
    class="visually-hidden"
    aria-live="assertive"
    role="status"
    aria-atomic="true"
    ref="liveRegion"
  ></div>
    {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input
        type="hidden"
        name="id"
        ref="variantId"
        value="{{ current_variant.id }}"
        {% if current_variant.available == false %}
          disabled
        {% endif %}
      >
      <input
        type="hidden"
        name="quantity"
        value="{% if current_variant.quantity_rule.min %}{{ current_variant.quantity_rule.min }}{% else %}1{% endif %}"
      >
        {% render 'add-to-cart-button',
          add_to_cart_text: add_to_cart_text,
          class: 'button button-primary product-nav__button--add',
          can_add_to_cart: can_add_to_cart,
          icon_only_on_mobile: false,
          product: product
        %}
    {%- endform -%}
</product-form-component>

